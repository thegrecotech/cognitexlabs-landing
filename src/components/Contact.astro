---
const contactMethods = [
  {
    label: 'Email',
    value: 'info@cognitexlabs.com',
    href: 'mailto:info@cognitexlabs.com',
  },
  {
    label: 'Teléfono',
    value: '+57 300 123 4567',
    href: 'tel:+573001234567',
  },
  {
    label: 'Ubicación',
    value: 'Medellín, Colombia',
    href: null,
  },
];
---

<section id="contacto" class="px-6 py-24 bg-brand-navy-light/40">
  <div class="mx-auto max-w-4xl rounded-3xl border border-white/10 bg-white/[0.03] px-8 py-14 text-center relative overflow-hidden">
    <div class="pointer-events-none absolute -top-20 -right-20 h-72 w-72 rounded-full bg-brand-purple/20 blur-2xl"></div>

    <span class="text-xs font-semibold tracking-[0.2em] text-brand-blue">CONTÁCTANOS</span>
    <h2 class="mt-3 font-display font-bold text-3xl sm:text-4xl text-white">¿Tienes un proyecto en mente?</h2>
    <p class="mt-4 text-brand-gray/70 max-w-xl mx-auto">
      Cuéntanos qué necesitas y te contactamos para conversar sobre cómo podemos ayudarte.
    </p>

    <div class="mt-8">
      <a
        href="mailto:info@cognitexlabs.com"
        class="inline-flex items-center justify-center rounded-full bg-gradient-brand px-8 py-3.5 text-sm font-semibold text-white shadow-lg shadow-brand-purple/25 hover:opacity-90 transition-opacity"
      >
        Escríbenos
      </a>
    </div>

    <div class="mt-12 grid grid-cols-1 sm:grid-cols-3 gap-6 text-left">
      {contactMethods.map((method) => (
        <div class="rounded-xl border border-white/10 p-4">
          <p class="text-xs font-semibold tracking-wide uppercase text-brand-gray/50">{method.label}</p>
          {method.href ? (
            <a href={method.href} class="mt-1 block text-white font-medium hover:text-brand-blue transition-colors">
              {method.value}
            </a>
          ) : (
            <p class="mt-1 text-white font-medium">{method.value}</p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
