---
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="px-6 py-10 border-t border-white/5">
  <div class="mx-auto max-w-6xl flex flex-col sm:flex-row items-center justify-between gap-4">
    <Logo size={28} />
    <p class="text-xs text-brand-gray/50 text-center">
      © {year} Cognitex Labs. Todos los derechos reservados.
    </p>
    <p class="text-xs text-brand-gray/50 font-display tracking-wide">Inteligencia que construye el futuro</p>
  </div>
</footer>
