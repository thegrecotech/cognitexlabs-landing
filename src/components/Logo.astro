---
interface Props {
  size?: number;
}

const { size = 48 } = Astro.props;
const ratio = 317 / 224;
const width = Math.round(size * ratio);
---

<a href="/" class="flex items-center shrink-0">
  <img
    src="/logo.png"
    alt="Cognitex Labs"
    width={width}
    height={size}
    style={{ height: `${size}px`, width: `${width}px` }}
    class="object-contain"
  />
</a>
