---
const products = [
  {
    name: 'Vexa',
    url: 'https://www.vexa.eco',
    tagline: 'Plataforma de registro y gestión ganadera',
    description:
      'Software para el control y trazabilidad del hato ganadero: registro de animales, historial, reportes y más, en un solo lugar.',
    status: 'En producción',
  },
  {
    name: 'Treboly',
    url: 'https://www.treboly.net',
    tagline: 'Gestión profesional de rifas',
    description:
      'App para organizar rifas sin papel ni chats: venta de números, clientes, cobros y cierre automático con el resultado oficial de la lotería.',
    status: 'En producción',
    availability: 'Disponible en Android · iOS próximamente',
  },
  {
    name: 'Torny Pass',
    url: 'https://torny.net',
    tagline: 'Fidelización multi-comercio',
    description:
      'Una billetera que reúne en un solo lugar los programas de fidelización de tus comercios favoritos: barberías, heladerías, gimnasios y más.',
    status: 'En desarrollo',
    availability: 'Próximamente',
  },
];
---

<section id="productos" class="px-6 py-24 bg-slate-50">
  <div class="mx-auto max-w-6xl">
    <div class="reveal text-center max-w-2xl mx-auto">
      <span class="text-xs font-semibold tracking-[0.2em] text-brand-purple">NUESTROS PRODUCTOS</span>
      <h2 class="mt-3 font-display font-bold text-3xl sm:text-4xl text-brand-navy">Lo que construimos</h2>
      <p class="mt-4 text-slate-600">
        Además de proyectos a la medida, desarrollamos y operamos nuestros propios productos.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {products.map((product, i) => (
        <div style={`--delay: ${i * 120}ms`} class="reveal relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-8 flex flex-col shadow-sm hover:shadow-lg hover:shadow-brand-purple/10 transition-shadow">
          <div class="absolute inset-x-0 top-0 h-1 bg-gradient-brand"></div>
          <span class="self-start text-[11px] font-semibold tracking-wide uppercase rounded-full bg-brand-purple/10 text-brand-purple px-3 py-1">
            {product.status}
          </span>
          <a
            href={product.url}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 font-display font-black text-2xl text-brand-navy hover:text-brand-purple transition-colors"
          >
            {product.name}
          </a>
          <p class="mt-1 text-sm font-medium text-slate-500">{product.tagline}</p>
          <p class="mt-4 text-slate-600 leading-relaxed flex-1">{product.description}</p>
          {product.availability && (
            <p class="mt-5 text-xs font-semibold tracking-wide text-slate-500">{product.availability}</p>
          )}
          <a
            href={product.url}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-brand-purple hover:text-brand-navy transition-colors"
          >
            Visitar sitio →
          </a>
        </div>
      ))}

      <div class="reveal md:col-span-2 lg:col-span-3 rounded-2xl border border-dashed border-slate-300 p-8 text-center">
        <p class="font-display font-bold text-brand-navy">Más proyectos en camino</p>
        <p class="mt-2 text-sm text-slate-500">Seguimos construyendo. Pronto contaremos más.</p>
      </div>
    </div>
  </div>
</section>
