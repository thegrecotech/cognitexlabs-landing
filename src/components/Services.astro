---

<section id="servicios" class="px-6 py-24 bg-white">
  <div class="mx-auto max-w-6xl">
    <div class="reveal text-center max-w-2xl mx-auto">
      <span class="text-xs font-semibold tracking-[0.2em] text-brand-purple">QUÉ HACEMOS</span>
      <h2 class="mt-3 font-display font-bold text-3xl sm:text-4xl text-brand-navy">Nuestros servicios</h2>
      <p class="mt-4 text-slate-600">
        Desarrollamos soluciones de software e inteligencia artificial que impulsan el futuro de tu negocio.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {services.map((service, i) => (
        <div style={`--delay: ${(i % 4) * 90}ms`} class="reveal group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:-translate-y-1 hover:border-brand-purple/30 hover:shadow-lg hover:shadow-brand-purple/10 transition-all">
          <div class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-brand shadow-md shadow-brand-purple/20">
            <svg
              class="h-5.5 w-5.5 text-white"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d={service.icon} />
            </svg>
          </div>
          <h3 class="mt-4 font-display font-bold text-sm tracking-wide text-brand-navy">{service.title}</h3>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
